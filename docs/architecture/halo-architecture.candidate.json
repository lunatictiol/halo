  "cards": [
    { "dot": "cyan", "title": "Query path", "items": ["The graph runs retrieve, rerank, grade, then generate and verify", "Grader and generator see the original question; only retrieval uses the rewrite", "Every node appends a timed trace entry, streamed as SSE steps"] },
    { "dot": "amber", "title": "Corrective loop", "items": ["Insufficient evidence triggers rewrite and a second retrieve", "route_after_grade is the only place the retry limit is enforced", "No retries left: abstain with the grader's reason"] },
    { "dot": "emerald", "title": "Grounding", "items": ["Code turns [Pn] markers into paper, section, page", "Each sentence is checked against its cited passages", "Unsupported sentences are re-attributed or removed; none left means abstain"] },
    { "dot": "violet", "title": "Indexing", "items": ["Chunks keep paper id, section id, section title, page", "Point ids are deterministic, so re-ingesting overwrites", "Queries embed through Ollama; BM25 is rebuilt from Qdrant payloads"] }
